# Copy to .env (gitignored); docker compose reads it automatically.

# Upstream / classifier secrets, referenced from config.yaml as ${LOCAL_KEY} etc.
LOCAL_KEY=
PUBLIC_KEY=
CLASSIFIER_KEY=

# Key Open WebUI uses to call the gateway. Put its sha256 in config.yaml:
#   auth.keys: [{id: openwebui, sha256: "<printf %s "$OPENWEBUI_GATEWAY_KEY" | shasum -a 256>"}]
OPENWEBUI_GATEWAY_KEY=

# Open WebUI session signing key (any long random string; keep it stable).
WEBUI_SECRET_KEY=

# Grafana admin password (user: admin)
GRAFANA_ADMIN_PASSWORD=

# Host ports
GATEWAY_PORT=8080
OPENWEBUI_PORT=3000
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
