# Copy to .env (gitignored); docker compose reads it automatically.
# Values marked (required) must be set or `docker compose up` refuses to start.
# Generate random values with: openssl rand -base64 32

# Upstream / classifier secrets, referenced from config.yaml as ${LOCAL_KEY} etc.
LOCAL_KEY=
PUBLIC_KEY=
CLASSIFIER_KEY=

# (required) Key Open WebUI uses to call the gateway. Put its sha256 in config.yaml:
#   auth.keys: [{id: openwebui, sha256: "<printf %s "$OPENWEBUI_GATEWAY_KEY" | shasum -a 256>"}]
OPENWEBUI_GATEWAY_KEY=

# (required) Open WebUI session signing key (any long random string; keep it stable).
WEBUI_SECRET_KEY=

# (required) Grafana admin password (user: admin)
GRAFANA_ADMIN_PASSWORD=

# (required) Redis password. Reference it in config.yaml: redis.password: "${REDIS_PASSWORD}"
REDIS_PASSWORD=

# Optional bearer token for /metrics (server.metrics_auth_token: "${METRICS_TOKEN}").
# Prometheus then needs the same value in prometheus/metrics_token (see compose.yml).
METRICS_TOKEN=

# Host interface for the gateway and Open WebUI ports. 127.0.0.1 = this machine only;
# set 0.0.0.0 to expose them on the network (put a TLS reverse proxy in front).
BIND_ADDR=127.0.0.1

# Host ports
GATEWAY_PORT=8080
OPENWEBUI_PORT=3000
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
